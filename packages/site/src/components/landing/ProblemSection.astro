---
const painPoints = [
  {
    title: "Sessions vanish",
    desc: "Close your laptop lid, lose your context. Terminal sessions are ephemeral.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18.36 6.64A9 9 0 0 1 20.77 15M5.64 18.36A9 9 0 0 1 3.23 9"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
  },
  {
    title: "No cross-device",
    desc: "Can't check on sessions from your phone during a commute.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
  },
  {
    title: "Permissions timeout",
    desc: "AI agents wait for approval you never see. Work grinds to a halt.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
  {
    title: "Invisible usage",
    desc: "No unified view of token spend, model distribution, or cache efficiency.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
  },
  {
    title: "Silent crashes",
    desc: "A session crashes and you don't notice for 30 minutes.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  },
  {
    title: "No orchestration",
    desc: "Each session is isolated. No way to chain tasks or share context.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
  },
];
---

<section class="py-24 px-4 reveal">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-h2 font-bold tracking-tight text-center">
      The terminal tab problem.
    </h2>
    <p class="mt-4 text-lg text-muted text-center max-w-2xl mx-auto">
      AI coding agents changed how we write code. Managing them hasn't caught up.
    </p>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-5">
      {painPoints.map((item, i) => (
        <div class:list={[
          "group p-5 rounded-xl border border-border bg-card/40 backdrop-blur-sm",
          "hover:border-destructive/20 transition-all duration-200",
          `reveal stagger-${i + 1}`,
        ]}>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-destructive/8 flex items-center justify-center flex-shrink-0 text-destructive/70 group-hover:text-destructive group-hover:bg-destructive/12 transition-colors">
              <Fragment set:html={item.icon} />
            </div>
            <div>
              <h3 class="font-semibold text-foreground">{item.title}</h3>
              <p class="mt-1 text-sm text-muted leading-relaxed">{item.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
