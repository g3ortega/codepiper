---
---

<section class="py-24 px-4 reveal">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-h2 font-bold tracking-tight text-foreground">
      See everything at a glance.
    </h2>
    <p class="mt-4 text-lg text-muted max-w-2xl mx-auto">
      Real-time terminal output, session status, analytics, and policy audit. All in one dashboard.
    </p>

    <div class="relative mt-16 max-w-5xl mx-auto">
      <!-- Dashboard mock -->
      <div
        class="rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden"
        style="box-shadow: 0 25px 60px -15px rgba(0,0,0,0.5), 0 0 40px -10px rgba(6,182,212,0.08);"
      >
        <!-- Window chrome -->
        <div class="h-8 flex items-center px-3 gap-1.5 border-b border-border bg-card">
          <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></div>
          <span class="ml-2 text-[10px] text-muted-foreground font-mono">CodePiper · Dashboard</span>
          <span class="ml-auto flex items-center gap-1.5 text-[10px] text-emerald font-mono">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            Connected
          </span>
        </div>

        <div class="flex">
          <!-- Sidebar -->
          <div class="hidden md:flex flex-col items-center py-3 px-1.5 border-r border-border bg-[#0a0c12] w-11 flex-shrink-0">
            <!-- Logo -->
            <div class="w-6 h-6 mb-2 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l7 4.5-7 4.5z"/></svg>
            </div>
            <!-- New session -->
            <div class="w-6 h-6 mb-3 rounded flex items-center justify-center bg-emerald/15 text-emerald cursor-default">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            </div>

            <!-- Nav icons -->
            <div class="flex flex-col items-center gap-2.5">
              <!-- Dashboard (active) -->
              <div class="w-6 h-6 rounded bg-primary/15 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              </div>
              <!-- Sessions with badge -->
              <div class="relative w-6 h-6 rounded flex items-center justify-center text-muted-foreground/50">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <span class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-primary text-[7px] font-bold text-white flex items-center justify-center">3</span>
              </div>
            </div>

            <!-- Active session shortcuts -->
            <div class="w-5 border-t border-border/40 my-2.5"></div>
            <div class="flex flex-col items-center gap-2">
              <!-- Session 1: Running (green icon like real app) -->
              <div class="w-6 h-6 rounded flex items-center justify-center text-emerald cursor-default" title="auth-module">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <!-- Session 2: Running -->
              <div class="w-6 h-6 rounded flex items-center justify-center text-emerald cursor-default" title="test-suite">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <!-- Session 3: Waiting (amber) -->
              <div class="w-6 h-6 rounded flex items-center justify-center text-amber cursor-default" title="api-refactor">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
            </div>
            <div class="w-5 border-t border-border/40 my-2.5"></div>

            <!-- Lower nav -->
            <div class="flex flex-col items-center gap-2.5">
              <div class="w-6 h-6 rounded flex items-center justify-center text-muted-foreground/50">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
              </div>
              <div class="w-6 h-6 rounded flex items-center justify-center text-muted-foreground/50">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 012 2v7"/><path d="M6 9v12"/></svg>
              </div>
              <div class="w-6 h-6 rounded flex items-center justify-center text-muted-foreground/50">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
            </div>

            <!-- Spacer + bottom -->
            <div class="flex-1"></div>
            <div class="flex flex-col items-center gap-2">
              <div class="w-6 h-6 rounded flex items-center justify-center text-muted-foreground/40">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
              </div>
              <!-- Connection status -->
              <div class="flex flex-col items-center gap-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span class="text-[7px] text-muted-foreground/40 font-mono">1.1</span>
              </div>
            </div>
          </div>

          <!-- Dashboard content -->
          <div class="flex-1 p-4 md:p-5 space-y-4">
            <!-- Stat cards row -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="rounded-lg bg-card/80 border border-border p-3 text-left">
                <div class="flex items-center justify-between">
                  <div class="text-[10px] text-muted-foreground font-mono uppercase tracking-wide">Active</div>
                  <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <div class="text-xl font-bold text-primary font-mono mt-1">3</div>
                <div class="text-[9px] text-muted-foreground/60 mt-0.5">5 total</div>
              </div>
              <div class="rounded-lg bg-card/80 border border-border p-3 text-left">
                <div class="flex items-center justify-between">
                  <div class="text-[10px] text-muted-foreground font-mono uppercase tracking-wide">Messages</div>
                  <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div class="text-xl font-bold text-foreground font-mono mt-1">247</div>
                <div class="text-[9px] text-muted-foreground/60 mt-0.5">User + assistant</div>
              </div>
              <div class="rounded-lg bg-card/80 border border-border p-3 text-left">
                <div class="flex items-center justify-between">
                  <div class="text-[10px] text-muted-foreground font-mono uppercase tracking-wide">Tokens</div>
                  <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
                </div>
                <div class="text-xl font-bold text-foreground font-mono mt-1">2.4M</div>
                <div class="text-[9px] text-muted-foreground/60 mt-0.5">1.8M cached</div>
              </div>
              <div class="rounded-lg bg-card/80 border border-border p-3 text-left">
                <div class="flex items-center justify-between">
                  <div class="text-[10px] text-muted-foreground font-mono uppercase tracking-wide">Cache</div>
                  <svg class="w-3.5 h-3.5 text-muted-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <div class="text-xl font-bold text-emerald font-mono mt-1">87%</div>
                <div class="text-[9px] text-muted-foreground/60 mt-0.5">Excellent</div>
              </div>
            </div>

            <!-- Recent Sessions -->
            <div class="rounded-lg bg-card/80 border border-border overflow-hidden">
              <div class="px-4 py-2.5 border-b border-border flex items-center justify-between">
                <span class="text-xs font-semibold text-foreground">Recent Sessions</span>
                <span class="text-[10px] text-muted-foreground hover:text-primary cursor-default">View all &rarr;</span>
              </div>
              <div class="divide-y divide-border/50">
                <!-- Row 1: Running Claude Code -->
                <div class="px-4 py-2.5 flex items-center gap-3 bg-primary/3">
                  <span class="font-mono text-[10px] text-muted-foreground/60 w-[68px] truncate">a1b2c3d4...</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-medium bg-amber/10 text-amber border border-amber/20">
                    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/></svg>
                    Claude Code
                  </span>
                  <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-emerald/10 text-emerald border border-emerald/20">Running</span>
                  <span class="text-xs font-medium text-foreground truncate flex-1">auth-module</span>
                  <span class="text-[10px] text-muted-foreground/50 font-mono">2m ago</span>
                </div>
                <!-- Row 2: Running Codex -->
                <div class="px-4 py-2.5 flex items-center gap-3">
                  <span class="font-mono text-[10px] text-muted-foreground/60 w-[68px] truncate">e5f6g7h8...</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-medium bg-primary/10 text-primary border border-primary/20">
                    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/></svg>
                    Codex
                  </span>
                  <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-emerald/10 text-emerald border border-emerald/20">Running</span>
                  <span class="text-xs font-medium text-muted truncate flex-1">test-suite</span>
                  <span class="text-[10px] text-muted-foreground/50 font-mono">5m ago</span>
                </div>
                <!-- Row 3: Waiting -->
                <div class="px-4 py-2.5 flex items-center gap-3">
                  <span class="font-mono text-[10px] text-muted-foreground/60 w-[68px] truncate">i9j0k1l2...</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-medium bg-amber/10 text-amber border border-amber/20">
                    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/></svg>
                    Claude Code
                  </span>
                  <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-amber/10 text-amber border border-amber/20">Waiting</span>
                  <span class="text-xs font-medium text-muted truncate flex-1">api-refactor</span>
                  <span class="text-[10px] text-muted-foreground/50 font-mono">12m ago</span>
                </div>
                <!-- Row 4: Stopped -->
                <div class="px-4 py-2.5 flex items-center gap-3 opacity-60">
                  <span class="font-mono text-[10px] text-muted-foreground/60 w-[68px] truncate">m3n4o5p6...</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-medium bg-card text-muted-foreground border border-border">
                    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/></svg>
                    Claude Code
                  </span>
                  <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-card text-muted-foreground border border-border">Stopped</span>
                  <span class="text-xs font-medium text-muted truncate flex-1">docs-update</span>
                  <span class="text-[10px] text-muted-foreground/50 font-mono">1h ago</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating callouts -->
      <div class="hidden lg:block">
        <!-- Left callout: Session Control -->
        <div class="absolute -left-4 top-[55%] -translate-x-full max-w-[180px] text-right reveal stagger-1">
          <div class="inline-block px-3 py-2 rounded-lg bg-card/80 border border-primary/20 backdrop-blur-sm">
            <div class="text-xs font-medium text-primary">Multi-Provider</div>
            <div class="text-[11px] text-muted mt-0.5">Claude Code + Codex side by side</div>
          </div>
          <svg class="absolute top-1/2 -right-3 -translate-y-1/2 w-3 h-px" aria-hidden="true">
            <line x1="0" y1="0.5" x2="12" y2="0.5" stroke="rgba(6,182,212,0.3)" stroke-width="1" />
          </svg>
        </div>

        <!-- Right callout: Token Analytics -->
        <div class="absolute -right-4 top-[22%] translate-x-full max-w-[180px] text-left reveal stagger-2">
          <div class="inline-block px-3 py-2 rounded-lg bg-card/80 border border-secondary/20 backdrop-blur-sm">
            <div class="text-xs font-medium text-secondary">Token Analytics</div>
            <div class="text-[11px] text-muted mt-0.5">Usage, cache rate, estimated cost</div>
          </div>
          <svg class="absolute top-1/2 -left-3 -translate-y-1/2 w-3 h-px" aria-hidden="true">
            <line x1="0" y1="0.5" x2="12" y2="0.5" stroke="rgba(139,92,246,0.3)" stroke-width="1" />
          </svg>
        </div>

        <!-- Right callout: Live Status -->
        <div class="absolute -right-4 bottom-[30%] translate-x-full max-w-[180px] text-left reveal stagger-3">
          <div class="inline-block px-3 py-2 rounded-lg bg-card/80 border border-emerald/20 backdrop-blur-sm">
            <div class="text-xs font-medium text-emerald">Live Status</div>
            <div class="text-[11px] text-muted mt-0.5">Running, waiting, stopped, crashed</div>
          </div>
          <svg class="absolute top-1/2 -left-3 -translate-y-1/2 w-3 h-px" aria-hidden="true">
            <line x1="0" y1="0.5" x2="12" y2="0.5" stroke="rgba(16,185,129,0.3)" stroke-width="1" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
