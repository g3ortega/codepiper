---
const highlights = [
  "Password + TOTP MFA",
  "Encrypted env storage",
  "Rate limiting",
  "CSRF/origin protection",
  "Unix socket isolation",
  "Full audit trail",
];
---

<section class="py-24 px-4 reveal">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-h2 font-bold tracking-tight text-foreground">
        Trust boundaries for <span class="text-primary">AI agents</span>.
      </h2>
      <p class="mt-4 text-lg text-muted max-w-2xl mx-auto">
        Define what your agents can do. Get notified when they can't. Review every decision.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Policy rule example -->
      <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
        <div class="px-4 py-2.5 border-b border-border flex items-center gap-2">
          <span class="text-xs text-muted-foreground font-mono">Policy: dev-safety</span>
        </div>
        <pre class="p-4 text-[13px] leading-relaxed font-mono">
<code><span class="text-muted-foreground">rules:</span>
  - <span class="text-muted-foreground">action:</span> <span class="text-emerald font-semibold">allow</span>
    <span class="text-muted-foreground">tool:</span> <span class="text-foreground">"Read"</span>

  - <span class="text-muted-foreground">action:</span> <span class="text-emerald font-semibold">allow</span>
    <span class="text-muted-foreground">tool:</span> <span class="text-foreground">"Edit"</span>
    <span class="text-muted-foreground">cwd:</span> <span class="text-foreground">"*/src/**"</span>

  - <span class="text-muted-foreground">action:</span> <span class="text-destructive font-semibold">deny</span>
    <span class="text-muted-foreground">tool:</span> <span class="text-foreground">"Bash"</span>
    <span class="text-muted-foreground">cwd:</span> <span class="text-foreground">"*/production-*"</span>

  - <span class="text-muted-foreground">action:</span> <span class="text-amber font-semibold">ask</span>
    <span class="text-muted-foreground">tool:</span> <span class="text-foreground">"*"</span></code></pre>
      </div>

      <!-- Audit log -->
      <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
        <div class="px-4 py-2.5 border-b border-border flex items-center gap-2">
          <span class="text-xs text-muted-foreground font-mono">Audit Log</span>
        </div>
        <div class="p-4">
          <div class="grid grid-cols-[auto_auto_1fr_auto] gap-x-4 gap-y-3 text-xs font-mono">
            <span class="text-muted-foreground">Time</span>
            <span class="text-muted-foreground">Tool</span>
            <span class="text-muted-foreground">Decision</span>
            <span class="text-muted-foreground">Source</span>

            <span class="text-muted">14:23:01</span>
            <span class="text-foreground">Read</span>
            <span class="text-emerald">allow</span>
            <span class="text-muted">auto #1</span>

            <span class="text-muted">14:23:15</span>
            <span class="text-foreground">Bash</span>
            <span class="text-destructive">deny</span>
            <span class="text-muted">auto #3</span>

            <span class="text-muted">14:24:02</span>
            <span class="text-foreground">Edit</span>
            <span class="text-amber">ask &rarr; allow</span>
            <span class="text-muted">manual</span>

            <span class="text-muted">14:24:08</span>
            <span class="text-foreground">Write</span>
            <span class="text-emerald">allow</span>
            <span class="text-muted">auto #1</span>

            <span class="text-muted">14:25:33</span>
            <span class="text-foreground">Bash</span>
            <span class="text-emerald">allow</span>
            <span class="text-muted">auto #2</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Security highlights -->
    <div class="mt-12 grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
      {highlights.map((feature) => (
        <div class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg bg-card/40 border border-border">
          <svg class="w-4 h-4 text-emerald flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5" />
          </svg>
          <span class="text-sm text-muted">{feature}</span>
        </div>
      ))}
    </div>
  </div>
</section>
