---
import PortabilityShowcase from "@/components/interactive/PortabilityShowcase";
---

<section class="relative">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-16 reveal">
      <h2 class="text-h2 font-bold tracking-tight">
        Start anywhere.
        <span class="text-primary">Continue everywhere.</span>
      </h2>
      <p class="mt-4 text-lg text-muted max-w-2xl mx-auto">
        Your sessions live on the daemon. Access them from any surface:
        desktop, mobile, tablet, or raw terminal.
      </p>
    </div>
  </div>

  <PortabilityShowcase client:idle />
</section>
