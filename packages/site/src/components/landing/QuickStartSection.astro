---
const commands = [
  { comment: "Install", cmd: "npm i -g codepiper" },
  { comment: "Check prerequisites", cmd: "codepiper doctor" },
  { comment: "Start with web dashboard", cmd: "codepiper daemon --web" },
  { comment: "Create your first session", cmd: "codepiper start -p claude-code -d ~/my-project" },
];
---

<section class="py-24 px-4 reveal">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-h2 font-bold tracking-tight">
      Get started in <span class="text-primary">2 minutes</span>.
    </h2>

    <div class="mt-12 text-left">
      <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden"
           style="box-shadow: 0 20px 50px -15px rgba(0,0,0,0.4), 0 0 30px -8px rgba(6,182,212,0.06);">
        <!-- Terminal chrome -->
        <div class="h-9 flex items-center px-4 gap-1.5 border-b border-border bg-card/80">
          <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></div>
          <span class="ml-3 text-[10px] text-muted-foreground font-mono">Terminal</span>
          <button
            class="ml-auto text-muted-foreground hover:text-foreground transition-colors"
            data-copy={commands.map(c => c.cmd).join("\n")}
            aria-label="Copy all commands"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
            </svg>
          </button>
          <span class="sr-only" aria-live="polite" id="qs-copy-status"></span>
        </div>

        <div class="p-5 font-mono text-[13px] leading-[2] space-y-1">
          {commands.map((line) => (
            <div>
              <span class="text-muted-foreground select-none"># {line.comment}</span>
              <div class="flex items-center gap-2">
                <span class="text-emerald select-none">$</span>
                <span class="text-foreground">{line.cmd}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 flex items-center justify-center gap-4">
      <a
        href="/codepiper/docs/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
      >
        Read the Docs
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="https://github.com/g3ortega/codepiper"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border text-foreground font-medium hover:bg-card transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
    </div>

    <p class="mt-6 text-sm text-muted">
      Prerequisites: Bun 1.3.5+ &middot; tmux 3.0+ &middot; Claude Code or Codex
    </p>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const text = btn.getAttribute("data-copy");
      if (text) {
        navigator.clipboard.writeText(text);
        btn.classList.add("text-emerald");
        setTimeout(() => btn.classList.remove("text-emerald"), 1500);
        var status = document.getElementById("qs-copy-status");
        if (status) {
          status.textContent = "Copied to clipboard";
          setTimeout(function () { status.textContent = ""; }, 2000);
        }
      }
    });
  });
</script>
