---
---

<section class="py-24 px-4 reveal">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-h2 font-bold tracking-tight text-foreground">
        Full terminal. <span class="text-primary">Zero compromise.</span>
      </h2>
      <p class="mt-4 text-lg text-muted max-w-2xl mx-auto">
        The web dashboard gives you the same terminal experience as native tmux. Same session. Choose your surface.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Web terminal (matching real UI) -->
      <div>
        <div class="text-xs text-muted-foreground font-mono uppercase tracking-wide mb-3 text-center">
          Web Dashboard
        </div>
        <div class="rounded-xl border border-border bg-card/60 backdrop-blur-sm overflow-hidden">
          <!-- Session header -->
          <div class="px-3 py-2 border-b border-border flex items-center gap-2 flex-wrap">
            <span class="text-xs font-semibold text-foreground">auth-module</span>
            <span class="font-mono text-[9px] text-muted-foreground/50">a1b2c3d4...</span>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[8px] font-medium bg-amber/10 text-amber border border-amber/20">
              <svg class="w-2 h-2" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/></svg>
              Claude Code
            </span>
            <span class="inline-flex px-1.5 py-0.5 rounded text-[8px] font-bold uppercase bg-emerald/10 text-emerald border border-emerald/20">Running</span>
          </div>
          <!-- Tab bar -->
          <div class="px-3 py-1.5 border-b border-border flex items-center gap-1 text-[10px]">
            <span class="px-2 py-0.5 rounded text-primary border-b border-primary font-medium">Terminal</span>
            <span class="px-2 py-0.5 text-muted-foreground">Git</span>
            <span class="px-2 py-0.5 text-muted-foreground">Policies</span>
            <span class="px-2 py-0.5 text-muted-foreground">Logs</span>
            <span class="px-2 py-0.5 text-muted-foreground">Events</span>
          </div>
          <!-- Sub-tabs -->
          <div class="px-3 py-1.5 border-b border-border/50 flex items-center gap-2 text-[10px]">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/></svg>
              Tmux
            </span>
            <span class="px-2 py-0.5 text-muted-foreground">Conversation</span>
            <span class="px-2 py-0.5 text-muted-foreground">Attach</span>
            <span class="ml-auto flex items-center gap-1 text-emerald">
              <span class="w-1 h-1 rounded-full bg-emerald animate-pulse"></span>
              live
            </span>
          </div>
          <!-- Terminal content -->
          <div class="p-4 font-mono text-[11.5px] leading-relaxed min-h-[180px]" style="background: #0c0e14;">
            <div><span class="text-muted-foreground">{">"}</span> <span class="text-muted">Implementing the auth module...</span></div>
            <div class="mt-2"></div>
            <div class="text-primary">Created: src/auth/service.ts</div>
            <div class="text-primary">Created: src/auth/middleware.ts</div>
            <div class="text-primary">Modified: src/routes/index.ts</div>
            <div class="mt-2"></div>
            <div class="text-foreground text-[11px]">I've added Argon2 password hashing and</div>
            <div class="text-foreground text-[11px]">TOTP MFA support to the auth module.</div>
            <div class="mt-2"></div>
            <div><span class="text-muted-foreground">{">"}</span> <span class="text-foreground">What would you like me to do next?</span></div>
            <div class="mt-1"><span class="text-emerald">$ </span><span class="text-muted animate-pulse">&block;</span></div>
          </div>
        </div>
      </div>

      <!-- Native tmux -->
      <div>
        <div class="text-xs text-muted-foreground font-mono uppercase tracking-wide mb-3 text-center">
          Native tmux &middot; <code class="text-emerald/70">tmux attach</code>
        </div>
        <div class="rounded-lg border overflow-hidden" style="border-color: rgba(0,255,0,0.15); background: #0a0a0a; box-shadow: 0 0 30px rgba(0,255,0,0.03);">
          <div class="h-7 flex items-center px-3 border-b" style="border-color: rgba(0,255,0,0.1); background: #1a1a1a;">
            <span class="text-[10px] font-mono" style="color: rgba(0,255,0,0.6);">user@server · codepiper-a1b2c3d4</span>
          </div>
          <div class="p-4 font-mono text-[11.5px] leading-relaxed min-h-[180px]" style="color: #00ff00;">
            <div><span style="opacity:0.6;">{">"}</span> Implementing the auth module...</div>
            <div class="mt-2"></div>
            <div style="color: #00cc99;">Created: src/auth/service.ts</div>
            <div style="color: #00cc99;">Created: src/auth/middleware.ts</div>
            <div style="color: #00cc99;">Modified: src/routes/index.ts</div>
            <div class="mt-2"></div>
            <div style="color: #e0e0e0;">I've added Argon2 password hashing and</div>
            <div style="color: #e0e0e0;">TOTP MFA support to the auth module.</div>
            <div class="mt-2"></div>
            <div><span style="opacity:0.6;">{">"}</span> <span style="color: #e0e0e0;">What would you like me to do next?</span></div>
            <div class="mt-1"><span style="opacity:0.6;">$ </span><span class="animate-pulse" style="display:inline-block;width:8px;height:13px;background:#00ff00;">&#8203;</span></div>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-8 text-center text-sm text-muted">
      Same session. Same state. Same output. Choose your surface.
    </p>
  </div>
</section>
