---
interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
}

const footerLinks: Record<string, FooterLink[]> = {
  Product: [
    { href: "/codepiper/", label: "Features" },
    { href: "/codepiper/docs/", label: "Documentation" },
    { href: "/codepiper/blog/", label: "Blog" },
  ],
  Resources: [
    { href: "https://github.com/g3ortega/codepiper#readme", label: "Quick Start", external: true },
    { href: "https://github.com/g3ortega/codepiper/wiki", label: "Wiki", external: true },
    {
      href: "https://github.com/g3ortega/codepiper/blob/main/CHANGELOG.md",
      label: "Changelog",
      external: true,
    },
  ],
  Community: [
    { href: "https://github.com/g3ortega/codepiper", label: "GitHub", external: true },
    { href: "https://github.com/g3ortega/codepiper/issues", label: "Issues", external: true },
    {
      href: "https://github.com/g3ortega/codepiper/discussions",
      label: "Discussions",
      external: true,
    },
  ],
};
---

<footer class="relative border-t border-border bg-[#08090d]">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8">
      <!-- Brand column -->
      <div>
        <a href="/codepiper/" class="flex items-center gap-2.5 group">
          <img
            src="/codepiper/logo-64.png"
            alt="CodePiper logo"
            width="32"
            height="32"
            class="rounded-lg group-hover:scale-105 transition-transform"
          />
          <span class="text-base font-semibold text-foreground tracking-tight">
            CodePiper
          </span>
        </a>
        <p class="mt-3 text-sm text-muted leading-relaxed max-w-[240px]">
          Remote orchestrator for AI coding sessions. One daemon. Every device.
        </p>

        <!-- Tech badges -->
        <div class="mt-5 flex flex-wrap gap-2">
          {["Bun", "TypeScript", "tmux", "SQLite"].map((tech) => (
            <span class="px-2 py-0.5 rounded text-[10px] font-medium tracking-wide uppercase text-muted-foreground bg-card border border-border">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(footerLinks).map(([section, links]) => (
        <div>
          <h4 class="text-[11px] font-medium uppercase tracking-[0.08em] text-muted-foreground mb-4">
            {section}
          </h4>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted hover:text-primary transition-colors duration-150"
                  {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {link.label}
                  {link.external && (
                    <>
                      <svg class="inline-block w-3 h-3 ml-1 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
                      </svg>
                      <span class="sr-only">(opens in new tab)</span>
                    </>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="mt-12 mb-6">
      <div
        class="h-px max-w-[800px] mx-auto"
        style="background: linear-gradient(90deg, transparent 0%, rgba(6,182,212,0.15) 30%, rgba(139,92,246,0.1) 70%, transparent 100%);"
      ></div>
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-muted-foreground">
        &copy; {new Date().getFullYear()} CodePiper contributors &middot;
        <a href="https://github.com/g3ortega/codepiper/blob/main/LICENSE" class="hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">
          MIT License
        </a>
      </p>

      <!-- GitHub star -->
      <a
        href="https://github.com/g3ortega/codepiper"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border text-sm text-muted hover:text-foreground hover:border-muted-foreground/20 transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        Star on GitHub
      </a>
    </div>
  </div>
</footer>
