---
import { join } from "node:path/posix";

const bundlePath = join(import.meta.env.BASE_URL, "pagefind/pagefind.js");
---

<!-- Search modal overlay -->
<div
  id="docs-search-overlay"
  data-bundle-path={bundlePath}
  class="fixed inset-0 z-50 hidden items-start justify-center pt-[10vh] sm:pt-[14vh] px-4"
  style="background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
>
  <div
    class="w-full max-w-[520px] rounded-xl overflow-hidden"
    style="background: #13171f; border: 1px solid rgba(255,255,255,0.07); box-shadow: 0 25px 60px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03) inset;"
  >
    <!-- Input row -->
    <div class="flex items-center gap-3 px-4 py-3" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
      <svg class="w-[18px] h-[18px] shrink-0 text-[#4b5563]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="docs-search-input"
        type="text"
        placeholder="Search documentation..."
        autocomplete="off"
        spellcheck="false"
        class="flex-1 min-w-0 bg-transparent text-[15px] text-[#f3f4f6] placeholder-[#4b5563] outline-none border-none p-0"
      />
      <kbd
        class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-medium text-[#4b5563]"
        style="border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.03);"
      >esc</kbd>
    </div>

    <!-- Results -->
    <div
      id="docs-search-results"
      class="overflow-y-auto"
      style="max-height: 55vh; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent;"
    >
    </div>
  </div>
</div>

<script>
  interface PagefindResult {
    url: string;
    meta?: { title?: string };
    excerpt?: string;
    sub_results?: { title?: string; excerpt?: string }[];
  }

  interface PagefindSearch {
    results: { data(): Promise<PagefindResult> }[];
  }

  interface PagefindModule {
    init(): Promise<void>;
    search(query: string): Promise<PagefindSearch>;
  }

  declare global {
    interface Window {
      __openDocsSearch?: () => void;
    }
  }

  const bundlePath = document.getElementById("docs-search-overlay")?.dataset.bundlePath ?? "/codepiper/pagefind/pagefind.js";
  let pagefind: PagefindModule | null = null;
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;

  function getOverlay() {
    return document.getElementById("docs-search-overlay");
  }

  async function initPagefind() {
    if (pagefind) return;
    try {
      pagefind = await import(bundlePath) as PagefindModule;
      await pagefind.init();
    } catch (e) {
      console.warn("Pagefind init failed:", e);
    }
  }

  function openSearch() {
    const overlay = getOverlay();
    if (!overlay) return;
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
    initPagefind();
    requestAnimationFrame(() => {
      const input = document.getElementById("docs-search-input") as HTMLInputElement | null;
      if (input) { input.value = ""; input.focus(); }
      clearResults();
    });
  }

  function closeSearch() {
    const overlay = getOverlay();
    if (!overlay) return;
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function clearResults() {
    const el = document.getElementById("docs-search-results");
    if (el) el.replaceChildren();
  }

  /** Parse Pagefind excerpt HTML (contains <mark> tags) into DOM nodes safely */
  function parseExcerpt(excerptHtml: string) {
    const frag = document.createDocumentFragment();
    if (!excerptHtml) return frag;
    const parts = excerptHtml.split(/(<mark>.*?<\/mark>)/g);
    for (const part of parts) {
      const markMatch = part.match(/^<mark>(.*?)<\/mark>$/);
      if (markMatch) {
        const mark = document.createElement("mark");
        mark.textContent = markMatch[1];
        frag.appendChild(mark);
      } else {
        frag.appendChild(document.createTextNode(part));
      }
    }
    return frag;
  }

  function renderResults(results: PagefindResult[], query: string) {
    const container = document.getElementById("docs-search-results");
    if (!container) return;
    container.replaceChildren();

    if (!query) return;

    if (results.length === 0) {
      const empty = document.createElement("div");
      empty.style.cssText = "padding: 2rem 1.25rem; text-align: center; color: #4b5563; font-size: 0.8125rem;";
      empty.textContent = 'No results for "' + query + '"';
      container.appendChild(empty);
      return;
    }

    const countEl = document.createElement("div");
    countEl.style.cssText = "padding: 0.5rem 1rem 0.25rem; font-size: 0.6875rem; color: #4b5563; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase;";
    countEl.textContent = results.length + " result" + (results.length !== 1 ? "s" : "");
    container.appendChild(countEl);

    for (const result of results) {
      container.appendChild(buildResultEl(result));
    }
  }

  function buildResultEl(result: PagefindResult) {
    const { url, meta, excerpt, sub_results } = result;
    const title = (meta && meta.title) || "Untitled";

    const link = document.createElement("a");
    link.href = url;
    link.className = "docs-search-result";
    link.style.cssText = "display: block; padding: 0.625rem 1rem; text-decoration: none; transition: background 0.1s;";

    const titleEl = document.createElement("div");
    titleEl.style.cssText = "font-size: 0.8125rem; font-weight: 600; color: #e5e7eb; margin-bottom: 0.125rem;";
    titleEl.textContent = title;
    link.appendChild(titleEl);

    if (sub_results && sub_results.length > 0) {
      const subs = sub_results.slice(0, 3);
      for (const sub of subs) {
        const subWrap = document.createElement("div");
        subWrap.style.cssText = "padding-left: 0.75rem; margin-top: 0.375rem; border-left: 2px solid rgba(6,182,212,0.2);";

        if (sub.title && sub.title !== title) {
          const subTitle = document.createElement("div");
          subTitle.style.cssText = "font-size: 0.75rem; font-weight: 500; color: #06b6d4; margin-bottom: 0.125rem;";
          subTitle.textContent = sub.title;
          subWrap.appendChild(subTitle);
        }

        if (sub.excerpt) {
          const subExcerpt = document.createElement("div");
          subExcerpt.style.cssText = "font-size: 0.6875rem; line-height: 1.5; color: #6b7280;";
          subExcerpt.appendChild(parseExcerpt(sub.excerpt));
          subWrap.appendChild(subExcerpt);
        }

        link.appendChild(subWrap);
      }
    } else if (excerpt) {
      const excerptEl = document.createElement("div");
      excerptEl.style.cssText = "font-size: 0.6875rem; line-height: 1.5; color: #6b7280; margin-top: 0.125rem;";
      excerptEl.appendChild(parseExcerpt(excerpt));
      link.appendChild(excerptEl);
    }

    return link;
  }

  async function doSearch(query: string) {
    if (!pagefind || !query) {
      renderResults([], query);
      return;
    }
    try {
      const search = await pagefind.search(query);
      const loaded = await Promise.all(
        search.results.slice(0, 8).map(function (r) { return r.data(); })
      );
      renderResults(loaded, query);
    } catch (e) {
      console.warn("Search failed:", e);
    }
  }

  // Input with debounce
  document.getElementById("docs-search-input")?.addEventListener("input", function (e) {
    const target = e.target as HTMLInputElement;
    const query = target.value.trim();
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () { doSearch(query); }, 150);
  });

  // Click outside to close
  document.getElementById("docs-search-overlay")?.addEventListener("click", function (e) {
    if (e.target === e.currentTarget) closeSearch();
  });

  // Keyboard shortcuts
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      const overlay = getOverlay();
      if (overlay && !overlay.classList.contains("hidden")) {
        closeSearch();
        e.preventDefault();
      }
    }
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      const overlay = getOverlay();
      if (overlay && overlay.classList.contains("hidden")) {
        openSearch();
      } else {
        closeSearch();
      }
    }
  });

  window.__openDocsSearch = openSearch;
</script>

<style is:global>
  .docs-search-result:hover {
    background: rgba(255, 255, 255, 0.04) !important;
  }
  .docs-search-result + .docs-search-result {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  #docs-search-results mark {
    background: rgba(6, 182, 212, 0.18);
    color: #f3f4f6;
    padding: 0.05em 0.15em;
    border-radius: 0.15rem;
    font-weight: 500;
  }
  #docs-search-results::-webkit-scrollbar {
    width: 6px;
  }
  #docs-search-results::-webkit-scrollbar-track {
    background: transparent;
  }
  #docs-search-results::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
  }
</style>
