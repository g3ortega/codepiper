---
import NavBar from "@/components/shared/NavBar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 · Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <NavBar />

  <main id="main-content" class="min-h-screen flex flex-col items-center justify-center px-4 -mt-16">
    <div
      class="w-full max-w-lg rounded-xl overflow-hidden"
      style="background: rgba(22, 27, 34, 0.8); backdrop-filter: blur(20px); border: 1px solid rgba(6, 182, 212, 0.15); box-shadow: 0 0 40px -10px rgba(6, 182, 212, 0.1), 0 25px 50px -12px rgba(0, 0, 0, 0.4);"
      role="presentation"
    >
      <div
        class="flex items-center gap-2 px-4 py-3"
        style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);"
      >
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-full" style="background: #ff5f57;"></div>
          <div class="w-3 h-3 rounded-full" style="background: #febc2e;"></div>
          <div class="w-3 h-3 rounded-full" style="background: #28c840;"></div>
        </div>
        <span class="ml-2 text-xs text-muted-foreground font-mono">Terminal · codepiper</span>
      </div>

      <div class="p-6 font-mono text-[13px] leading-relaxed">
        <div>
          <span class="text-emerald">$ </span>
          <span class="text-foreground">codepiper navigate --to <span class="text-muted">{Astro.url.pathname}</span></span>
        </div>
        <div class="mt-3">
          <span class="text-destructive">Error:</span>
          <span class="text-muted"> Page not found (404)</span>
        </div>
        <div class="mt-1 text-muted">
          The requested path does not match any known route.
        </div>
        <div class="mt-4">
          <span class="text-emerald">$ </span>
          <span class="text-foreground">codepiper suggest</span>
        </div>
        <div class="mt-3 text-primary">
          Try one of these:
        </div>
      </div>
    </div>

    <div class="mt-8 w-full max-w-lg space-y-2">
      {[
        { href: "/codepiper/", label: "Home", desc: "Landing page" },
        { href: "/codepiper/docs/", label: "Docs", desc: "Documentation" },
        { href: "/codepiper/blog/", label: "Blog", desc: "Posts and announcements" },
        { href: "https://github.com/g3ortega/codepiper", label: "GitHub", desc: "Source code and issues" },
      ].map((link) => (
        <a
          href={link.href}
          class="flex items-center justify-between px-4 py-3 rounded-lg border border-border bg-card/40 hover:bg-card/60 hover:border-primary/15 transition-all group"
        >
          <div>
            <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">
              {link.label}
            </span>
            <span class="ml-2 text-xs text-muted-foreground">{link.desc}</span>
          </div>
          <svg
            class="w-4 h-4 text-muted-foreground group-hover:text-primary group-hover:translate-x-1 transition-all"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
