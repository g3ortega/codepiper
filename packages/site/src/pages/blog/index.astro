---
import { getCollection } from "astro:content";
import Footer from "@/components/shared/Footer.astro";
import NavBar from "@/components/shared/NavBar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Blog"
  description="Posts and announcements from the CodePiper team."
>
  <NavBar variant="blog" />

  <main id="main-content" class="pt-24 pb-16 px-4 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-h2 font-bold tracking-tight text-foreground">Blog</h1>
      <p class="mt-3 text-muted max-w-lg">
        Development updates, architecture deep dives, and workflow tips.
      </p>

      {posts.length === 0 ? (
        <div class="text-center py-16">
          <p class="text-muted">No posts yet. Check back soon.</p>
        </div>
      ) : (
        <div class="mt-12 space-y-8">
          {posts.map((post) => {
            const date = post.data.publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });

            return (
              <article class="group">
                <a
                  href={`/codepiper/blog/${post.id}/`}
                  class="block p-6 -mx-6 rounded-xl hover:bg-card/40 transition-colors"
                >
                  <div class="flex flex-wrap gap-2 mb-3">
                    {post.data.tags.map((tag) => (
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-medium tracking-wide uppercase bg-primary/8 text-primary">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <h2 class="text-xl font-semibold text-foreground group-hover:text-primary transition-colors">
                    {post.data.title}
                  </h2>

                  <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>

                  <div class="mt-4 flex items-center gap-3 text-xs text-muted-foreground">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {date}
                    </time>
                    <span class="text-border">&middot;</span>
                    <span>{post.data.author}</span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>
