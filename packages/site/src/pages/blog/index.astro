---
import Footer from "@/components/shared/Footer.astro";
import NavBar from "@/components/shared/NavBar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Blog"
  description="Posts and announcements from the CodePiper team."
>
  <NavBar variant="blog" />

  <main class="pt-24 pb-16 px-4 min-h-screen">
    <div class="max-w-3xl mx-auto text-center py-16">
      <div class="w-16 h-16 rounded-2xl bg-secondary/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <h2 class="text-h2 font-semibold text-foreground">Blog coming soon</h2>
      <p class="mt-3 text-muted max-w-md mx-auto">
        We'll be sharing development updates, architecture deep dives, and workflow tips here.
      </p>
      <a
        href="/codepiper/"
        class="inline-flex items-center gap-2 mt-8 px-5 py-2.5 rounded-lg border border-border text-sm text-muted hover:text-foreground transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Back to home
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
