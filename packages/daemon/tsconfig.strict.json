{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.integration.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.example.ts",
    "src/**/demo.ts"
  ]
}
